  "dialogues": {
	"old-miner": {
	  "id": "old-miner",
	  "title": "Old Miner",
	  "pages": [
		{
		  "text": "Them darn youngin's dug too deep and dug into a spiders nest! Now the mines are swarming with poisonous spiders killing the half of us! Don't go going in there if you like livin' boy!"
		}
	  ]
	},
	"forest-elder": {
	  "id": "forest-elder",
	  "title": "Elder Rowan",
	  "pages": [
		{
		  "text": "Welcome, traveler. Our roads are less safe each night with bandits and goblins. A powerful necromancer has taken up residence in the graveyard to the north. We need your help.",
		  "choices": [
			{
			  "label": "What happened here?",
			  "next_page": 1
			},
			{
			  "label": "Any advice for us?",
			  "next_page": 2
			},
			{
			  "label": "Farewell",
			  "end": true
			}
		  ]
		},
		{
		  "text": "The necromancer has raised the dead from our very own graveyard and is draining the power from the land. I cannot face him as I need to preserve my strength to keep this land from falling into darkness. Please destroy him and his minions!",
		  "choices": [
			{
			  "label": "Back",
			  "next_page": 0
			},
			{
			  "label": "Thanks",
			  "end": true
			}
		  ]
		},
		{
		  "text": "Start by facing the goblins and bandits that roam the forest. They are weak, but they travel in groups. Use your wits and your weapons to defeat them. Once you have cleared the forest, you will find the graveyard to the north.",
		  "choices": [
			{
			  "label": "Back",
			  "next_page": 0
			},
			{
			  "label": "Understood",
			  "end": true
			}
		  ]
		}
	  ]
	}
  },
